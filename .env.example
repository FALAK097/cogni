# Local Drizzle migration database
ENV="development"
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Cloudflare D1 runtime. Leave all blank to use local SQLite.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_SEARCH_TOKEN=""
D1_DATABASE_ID=""

# Cloudflare knowledge resources. Use separate values per environment.
R2_BUCKET_NAME="widget-development"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
SEARCH_INDEX="widget-search-development"

# AI providers
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# External tools + email
COMPOSIO_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="widget Support <support@example.com>"
RESEND_REPLY_TO="hi@falakgala.dev"
RESEND_WEBHOOK_SECRET=""

# Microsoft Teams Chat SDK adapter
TEAMS_APP_ID=""
TEAMS_APP_PASSWORD=""
TEAMS_APP_TENANT_ID=""

# Optional Widget AI Model overrides (values: OPENAI | GOOGLE)
WIDGET_MODEL_PROVIDER=""
WIDGET_MODEL_NAME=""
