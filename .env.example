# Local Prisma migration database
ENV="development"
DATABASE_URL="file:./prisma/dev.db"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Cloudflare D1 runtime. Leave all blank to use local SQLite.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
D1_DATABASE_ID=""

# Cloudflare knowledge resources. Use separate values per environment.
R2_BUCKET_NAME="widget-development"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
VECTORIZE_INDEX="widget-knowledge-development"
SEARCH_INDEX="widget-search-development"

# AI providers
OPENAI_API_KEY=""
GEMINI_API_KEY=""
