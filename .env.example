# Local PostgreSQL. The Neon/Vercel integration injects both URLs in production.
ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cogni"
DATABASE_URL_UNPOOLED=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare APIs retained after deploying the application to Vercel.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_SEARCH_TOKEN=""

# Cloudflare knowledge resources. Use separate values per environment.
R2_BUCKET_NAME="cogni-development"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
SEARCH_INDEX="cogni-search-development"

# AI providers
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# External tools + email
COMPOSIO_API_KEY=""
COMPOSIO_WEBHOOK_SECRET=""

# Discord Bot via Composio. Permission value enables messages, history, embeds,
# attachments, threads, and reactions without administrator access.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_PERMISSIONS="274878221376"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="cogni Support <support@example.com>"
RESEND_REPLY_TO="hi@falakgala.dev"
RESEND_WEBHOOK_SECRET=""

# Microsoft Teams Chat SDK adapter
TEAMS_APP_ID=""
TEAMS_APP_PASSWORD=""
TEAMS_APP_TENANT_ID=""

# Optional embedded assistant model overrides (values: OPENAI | GOOGLE)

WIDGET_MODEL_PROVIDER=""
WIDGET_MODEL_NAME=""
