# Local Prisma migration database
DATABASE_URL="file:./prisma/dev.db"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Cloudflare D1 runtime. Leave all blank to use local SQLite.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
D1_DATABASE_ID=""
D1_SHADOW_DATABASE_ID=""

# Cloudflare resources reserved for later phases
R2_BUCKET_NAME=""
VECTORIZE_INDEX=""

# AI providers reserved for agent phase
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Vercel integrations reserved for later phases
VERCEL_TOKEN=""
VERCEL_CONNECT_SECRET=""
