{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "widget-prod",
  "account_id": "598a393819cd44e21ef2145dabea9a2f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENV": "production",
    "DATABASE_URL": "file:./dev.db",
    "BETTER_AUTH_URL": "https://widget-prod.falak-widget.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "598a393819cd44e21ef2145dabea9a2f",
    "D1_DATABASE_ID": "c0e9cc6e-438a-4b4f-9bf1-73c24d4417a4",
    "R2_BUCKET_NAME": "widget-prod-uploads",
    "SEARCH_INDEX": "widget-prod-search",
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "widget-prod-uploads",
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "widget-prod-next-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "widget-prod",
      "database_id": "c0e9cc6e-438a-4b4f-9bf1-73c24d4417a4",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "BETTER_AUTH_SECRET",
      "store_id": "06b91271c8384381b58665f385311eee",
      "secret_name": "BETTER_AUTH_SECRET",
    },
    {
      "binding": "GOOGLE_CLIENT_ID",
      "store_id": "06b91271c8384381b58665f385311eee",
      "secret_name": "GOOGLE_CLIENT_ID",
    },
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "06b91271c8384381b58665f385311eee",
      "secret_name": "GOOGLE_CLIENT_SECRET",
    },
  ],
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "widget-prod-search",
    },
  ],
  "env": {
    "preview": {
      "name": "widget-preview",
      "preview_urls": true,
      "vars": {
        "ENV": "production",
        "DATABASE_URL": "file:./dev.db",
        "BETTER_AUTH_URL": "https://widget-preview.falak-widget.workers.dev",
        "CLOUDFLARE_ACCOUNT_ID": "598a393819cd44e21ef2145dabea9a2f",
        "D1_DATABASE_ID": "198b258a-481e-4970-a17f-26de89c6785d",
        "R2_BUCKET_NAME": "widget-preview-uploads",
        "SEARCH_INDEX": "widget-preview-search",
      },
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "widget-preview-uploads",
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "widget-preview-next-cache",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "widget-preview",
          "database_id": "198b258a-481e-4970-a17f-26de89c6785d",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "BETTER_AUTH_SECRET",
          "store_id": "06b91271c8384381b58665f385311eee",
          "secret_name": "BETTER_AUTH_SECRET",
        },
        {
          "binding": "GOOGLE_CLIENT_ID",
          "store_id": "06b91271c8384381b58665f385311eee",
          "secret_name": "GOOGLE_CLIENT_ID",
        },
        {
          "binding": "GOOGLE_CLIENT_SECRET",
          "store_id": "06b91271c8384381b58665f385311eee",
          "secret_name": "GOOGLE_CLIENT_SECRET",
        },
      ],
      "ai_search": [
        {
          "binding": "AI_SEARCH",
          "instance_name": "widget-preview-search",
        },
      ],
    },
  },
}
