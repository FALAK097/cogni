{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "widget-prod",
  "account_id": "598a393819cd44e21ef2145dabea9a2f",
  "main": "cloudflare-worker.ts",
  "minify": true,
  "compatibility_date": "2026-06-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "alias": {
    "server-only": "./src/lib/cloudflare/server-only.ts",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENV": "production",
    "DATABASE_URL": "file:./dev.db",
    "BETTER_AUTH_URL": "https://widget-prod.widget-chat.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "598a393819cd44e21ef2145dabea9a2f",
    "D1_DATABASE_ID": "c0e9cc6e-438a-4b4f-9bf1-73c24d4417a4",
    "R2_BUCKET_NAME": "widget-prod-uploads",
    "SEARCH_INDEX": "widget-prod-search",
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "widget-prod-uploads",
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "widget-prod-next-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "widget-prod",
      "database_id": "c0e9cc6e-438a-4b4f-9bf1-73c24d4417a4",
      "migrations_dir": "drizzle",
    },
  ],
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "widget-prod-search",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "widget-ingestion-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "widget-ingestion-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "widget-ingestion-dead-letter",
        "retry_delay": 30,
      },
    ],
  },
  "workflows": [
    {
      "binding": "SOURCE_SYNC_WORKFLOW",
      "name": "widget-source-sync",
      "class_name": "SourceSyncWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_STATE",
        "class_name": "ChatStateDO",
      },
      {
        "name": "CONVERSATION_ROOMS",
        "class_name": "ConversationRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatStateDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ConversationRoom"],
    },
  ],
}
