generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String            @id
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      WorkspaceMember[]
  contactNotes     ContactNote[]
  notifications    Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  logo          String?
  brandColor    String         @default("#14805e")
  timezone      String         @default("UTC")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   WorkspaceMember[]
  contacts      Contact[]
  conversations Conversation[]
  attachments   Attachment[]
  documents     Document[]
  invites       WorkspaceInvite[]
  integrations  Integration[]
  notifications Notification[]
  events        DomainEvent[]
  workflowRuns  WorkflowRun[]
  integrationActions IntegrationAction[]
  widget        Widget?
  leads         Lead[]

  @@map("workspace")
}

model WorkspaceMember {
  id                    String         @id @default(cuid())
  role                  String         @default("MEMBER")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  userId                String
  workspaceId           String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_member")
}

model Contact {
  id              String           @id @default(cuid())
  name            String
  email           String?
  externalId      String?
  avatarUrl       String?
  tags            String           @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastSeenAt      DateTime?
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  visitorSessions VisitorSession[]
  notes           ContactNote[]
  leads           Lead[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, externalId])
  @@index([workspaceId, updatedAt])
  @@map("contact")
}

model ContactNote {
  id           String   @id @default(cuid())
  body         String
  createdAt    DateTime @default(now())
  contactId    String
  authorUserId String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([authorUserId])
  @@map("contact_note")
}

model Conversation {
  id               String          @id @default(cuid())
  subject          String
  status           String          @default("OPEN")
  channel          String          @default("WIDGET")
  aiPaused         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastMessageAt    DateTime        @default(now())
  messages         String          @default("[]") // JSON array storing Message objects
  workspaceId      String
  contactId        String
  assignedMemberId String?
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedMember   WorkspaceMember? @relation("ConversationAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  attachments      Attachment[]
  widgetId         String?
  visitorSessionId String?
  widget           Widget?         @relation(fields: [widgetId], references: [id], onDelete: SetNull)
  visitorSession   VisitorSession? @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, contactId])
  @@index([assignedMemberId])
  @@index([widgetId])
  @@index([visitorSessionId])
  @@map("conversation")
}

model Widget {
  id                           String             @id @default(cuid())
  publicKey                    String             @unique @default(cuid())
  displayName                  String             @default("Support")
  welcomeMessage               String             @default("Hi! How can we help?")
  inputPlaceholder             String             @default("Ask a question…")
  primaryColor                 String             @default("#14805e")
  backgroundColor              String             @default("#ffffff")
  textColor                    String             @default("#171717")
  position                     String             @default("bottom-right")
  launcherSize                 String             @default("md")
  panelWidth                   Int                @default(380)
  panelHeight                  Int                @default(640)
  borderRadius                 Int                @default(20)
  borderRadiusStyle            String             @default("default")
  logoUrl                      String?
  instructions                 String             @default("Answer clearly and only use information you know is reliable. If you are unsure, say so.")
  escalationKeywords           String             @default("human,agent,person,representative,support team")
  modelProvider                String             @default("OPENAI")
  modelName                    String             @default("gpt-5-mini")
  isEnabled                    Boolean            @default(true)
  theme                        String             @default("light")
  userBubbleColor              String             @default("#14805e")
  userBubbleTextColor          String             @default("#ffffff")
  botBubbleColor               String             @default("#f2f2f8")
  botBubbleTextColor           String             @default("#171717")
  headerGradientFrom           String             @default("#14805e")
  headerGradientTo             String             @default("#0f6b4e")
  shadowSize                   String             @default("md")
  suggestions                  String             @default("[\"What services do you offer?\",\"How can I get started?\",\"Tell me more about pricing\"]")
  hideSuggestionsOnInteract    Boolean            @default(true)
  previewMessages              String             @default("[\"Hi there! 👋\",\"Need help with anything?\"]")
  autoShowPreviewDelay         Int                @default(3000)
  showBranding                 Boolean            @default(true)
  privacyPolicyUrl             String             @default("/privacy-policy")
  enableLeadCapture            Boolean            @default(false)
  leadCaptureKeywords          String             @default("[\"contact\",\"contact me\",\"call me\",\"reach me\",\"get in touch\"]")
  leadCaptureMinutesThreshold  Int                @default(5)
  leadCaptureMessageThreshold  Int                @default(4)
  enableBrochure               Boolean            @default(false)
  brochureSuggestionText       String             @default("Receive Brochure")
  authorizedDomains            String             @default("[]") // stores serialized JSON array of hostnames
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  workspaceId                  String             @unique
  workspace                    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitorSessions              VisitorSession[]
  conversations                Conversation[]

  @@map("widget")
}

model VisitorSession {
  id                String             @id @default(cuid())
  token             String             @unique
  browserSessionId  String?
  visitorId         String?
  hostname          String
  externalId        String?
  pageUrl           String?
  referrer          String?
  browser           String?
  deviceType        String?
  os                String?
  country           String?
  city              String?
  timezone          String?
  language          String?
  screenSize        String?
  ipData            String?
  status            String             @default("active")
  messageCount      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastSeenAt        DateTime           @default(now())
  expiresAt         DateTime
  widgetId          String
  contactId         String?
  widget            Widget             @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  leadCapture       WidgetLeadCapture?

  @@index([widgetId, lastSeenAt])
  @@index([widgetId, visitorId])
  @@index([contactId])
  @@unique([widgetId, browserSessionId])
  @@map("visitor_session")
}

model Lead {
  id               String              @id @default(cuid())
  workspaceId      String
  contactId        String?
  name             String
  email            String?
  phone            String?
  source           String              @default("WIDGET")
  status           String              @default("new")
  capturedFromChat Boolean             @default(false)
  chatSessionId    String?
  chatSummary      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadCapture      WidgetLeadCapture?

  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@map("lead")
}

model WidgetLeadCapture {
  id                    String         @id @default(cuid())
  visitorSessionId      String         @unique
  leadId                String?        @unique
  triggerType           String
  triggerValue          String?
  formShownAt           DateTime       @default(now())
  formSubmittedAt       DateTime?
  abandoned             Boolean        @default(false)
  messageCountAtCapture Int            @default(0)
  conversationSummary   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  visitorSession        VisitorSession @relation(fields: [visitorSessionId], references: [id], onDelete: Cascade)
  lead                  Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("widget_lead_capture")
}

model Attachment {
  id             String       @id @default(cuid())
  filename       String
  mimeType       String
  size           Int
  storageKey     String       @unique
  createdAt      DateTime     @default(now())
  workspaceId    String
  conversationId String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
  @@map("attachment")
}

model Document {
  id           String          @id @default(cuid())
  title        String
  sourceType   String
  sourceUrl    String?
  storageKey   String?
  mimeType     String?
  status       String          @default("PROCESSING")
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([workspaceId, status, updatedAt])
  @@map("document")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  content    String
  position   Int
  createdAt  DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@map("document_chunk")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("MEMBER")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
  @@map("workspace_invite")
}

model Integration {
  id          String   @id @default(cuid())
  provider    String
  status      String   @default("DISCONNECTED")
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("integration")
}

model Notification {
  id          String    @id @default(cuid())
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notification")
}

model DomainEvent {
  id          String   @id @default(cuid())
  type        String
  entityId    String?
  payload     String   @default("{}")
  createdAt   DateTime @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
  @@map("domain_event")
}

model WorkflowRun {
  id             String    @id @default(cuid())
  name           String
  status         String    @default("RUNNING")
  idempotencyKey String?   @unique
  input          String    @default("{}")
  output         String?
  errorMessage   String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, startedAt])
  @@map("workflow_run")
}

model IntegrationAction {
  id             String    @id @default(cuid())
  provider       String
  actionType     String
  status         String    @default("PENDING")
  idempotencyKey String    @unique
  payload        String    @default("{}")
  result         String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspaceId    String
  requestedById  String?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@map("integration_action")
}
