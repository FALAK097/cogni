generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  authoredMessages Message[]
  contactNotes     ContactNote[]
  notifications    Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  logo          String?
  brandColor    String         @default("#14805e")
  timezone      String         @default("UTC")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  contacts      Contact[]
  conversations Conversation[]
  attachments   Attachment[]
  documents     Document[]
  invites       WorkspaceInvite[]
  integrations  Integration[]
  notifications Notification[]
  events        DomainEvent[]
  workflowRuns  WorkflowRun[]
  integrationActions IntegrationAction[]
  widget        Widget?

  @@map("workspace")
}

model Membership {
  id                    String         @id @default(cuid())
  role                  String         @default("MEMBER")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  userId                String
  workspaceId           String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("membership")
}

model Contact {
  id              String           @id @default(cuid())
  name            String
  email           String?
  externalId      String?
  avatarUrl       String?
  tags            String           @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastSeenAt      DateTime?
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  visitorSessions VisitorSession[]
  notes           ContactNote[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, externalId])
  @@index([workspaceId, updatedAt])
  @@map("contact")
}

model ContactNote {
  id           String   @id @default(cuid())
  body         String
  createdAt    DateTime @default(now())
  contactId    String
  authorUserId String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([authorUserId])
  @@map("contact_note")
}

model Conversation {
  id                   String          @id @default(cuid())
  subject              String
  status               String          @default("OPEN")
  channel              String          @default("MANUAL")
  aiPaused             Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastMessageAt        DateTime        @default(now())
  workspaceId          String
  contactId            String
  assignedMembershipId String?
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact              Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedMembership   Membership?     @relation("ConversationAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  messages             Message[]
  widgetId             String?
  visitorSessionId     String?
  widget               Widget?         @relation(fields: [widgetId], references: [id], onDelete: SetNull)
  visitorSession       VisitorSession? @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, contactId])
  @@index([assignedMembershipId])
  @@index([widgetId])
  @@index([visitorSessionId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  body           String
  authorType     String
  visibility     String       @default("PUBLIC")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversationId String
  authorUserId   String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser     User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  attachments    Attachment[]

  @@index([conversationId, createdAt])
  @@index([authorUserId])
  @@map("message")
}

model Widget {
  id                String             @id @default(cuid())
  publicKey         String             @unique @default(cuid())
  displayName       String             @default("Support")
  welcomeMessage    String             @default("Hi! How can we help?")
  inputPlaceholder  String             @default("Ask a question…")
  primaryColor      String             @default("#14805e")
  backgroundColor   String             @default("#ffffff")
  textColor         String             @default("#171717")
  position          String             @default("RIGHT")
  launcherSize      String             @default("MEDIUM")
  panelWidth        Int                @default(380)
  panelHeight       Int                @default(640)
  borderRadius      Int                @default(20)
  logoUrl           String?
  instructions      String             @default("Answer clearly and only use information you know is reliable. If you are unsure, say so.")
  escalationKeywords String            @default("human,agent,person,representative,support team")
  modelProvider     String             @default("OPENAI")
  modelName         String             @default("gpt-5-mini")
  isEnabled         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspaceId       String             @unique
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorizedDomains AuthorizedDomain[]
  visitorSessions   VisitorSession[]
  conversations     Conversation[]

  @@map("widget")
}

model AuthorizedDomain {
  id        String   @id @default(cuid())
  hostname  String
  createdAt DateTime @default(now())
  widgetId  String
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, hostname])
  @@index([hostname])
  @@map("authorized_domain")
}

model VisitorSession {
  id            String         @id @default(cuid())
  token         String         @unique
  hostname      String
  externalId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastSeenAt    DateTime       @default(now())
  expiresAt     DateTime
  widgetId      String
  contactId     String?
  widget        Widget         @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([widgetId, lastSeenAt])
  @@index([contactId])
  @@map("visitor_session")
}

model Attachment {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String
  size        Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())
  workspaceId String
  messageId   String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([messageId])
  @@map("attachment")
}

model Document {
  id           String          @id @default(cuid())
  title        String
  sourceType   String
  sourceUrl    String?
  storageKey   String?
  mimeType     String?
  status       String          @default("PROCESSING")
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([workspaceId, status, updatedAt])
  @@map("document")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  content    String
  position   Int
  createdAt  DateTime @default(now())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@map("document_chunk")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("MEMBER")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
  @@map("workspace_invite")
}

model Integration {
  id          String   @id @default(cuid())
  provider    String
  status      String   @default("DISCONNECTED")
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("integration")
}

model Notification {
  id          String    @id @default(cuid())
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notification")
}

model DomainEvent {
  id          String   @id @default(cuid())
  type        String
  entityId    String?
  payload     String   @default("{}")
  createdAt   DateTime @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
  @@map("domain_event")
}

model WorkflowRun {
  id             String    @id @default(cuid())
  name           String
  status         String    @default("RUNNING")
  idempotencyKey String?   @unique
  input          String    @default("{}")
  output         String?
  errorMessage   String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, startedAt])
  @@map("workflow_run")
}

model IntegrationAction {
  id             String    @id @default(cuid())
  provider       String
  actionType     String
  status         String    @default("PENDING")
  idempotencyKey String    @unique
  payload        String    @default("{}")
  result         String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspaceId    String
  requestedById  String?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@map("integration_action")
}
