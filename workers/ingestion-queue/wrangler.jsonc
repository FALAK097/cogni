{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cogni-ingestion-queue",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true,
  },
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "cogni-ingestion",
      },
    ],
  },
}
