# Copy to .env before starting the VPS Compose stack.
ENV=production
DATABASE_URL=postgresql://cogni:replace-with-a-URL-safe-secret@db:5432/cogni
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://your-domain.example
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
UPLOAD_STORAGE=local
CRON_SECRET=replace-with-at-least-16-random-characters
APP_PORT=3000

# Required for semantic knowledge retrieval. Set the Cloudflare account, token, and index.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_AI_SEARCH_TOKEN=replace-with-cloudflare-ai-search-token
SEARCH_INDEX=replace-with-cloudflare-ai-search-index

# Set one model provider key.
OPENAI_API_KEY=replace-with-openai-api-key
# GEMINI_API_KEY=replace-with-gemini-api-key
